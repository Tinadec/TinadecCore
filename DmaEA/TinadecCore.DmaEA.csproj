<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <RootNamespace>TinadecCore.DmaEA</RootNamespace>
    <Description>DmaEA: dual-layer multi-agent collaboration module based on MAF.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Abstractions\TinadecCore.Abstractions.csproj" />
    <ProjectReference Include="..\Persistence\TinadecCore.Persistence.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Agents.AI" />
    <PackageReference Include="Microsoft.Agents.AI.Abstractions" />
    <PackageReference Include="Microsoft.Agents.AI.OpenAI" />
    <PackageReference Include="Microsoft.Extensions.AI" />
    <!--
      Anthropic.SDK and Microsoft.Extensions.AI.OpenAI left with the protocol-aware chat client factory
      and the harness transports: the wire-protocol choice belongs to the model-interface module. What
      stays here is the agent runtime and MAF itself, so no DmaEA file names a provider SDK anymore.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Tomlyn" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Configuration\default-agent-runtime.toml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TinadecCore.Api.Tests" />
    <InternalsVisibleTo Include="TinadecCore.AgentFramework.Tests" />
    <InternalsVisibleTo Include="TinadecCore.AspNetCore" />
  </ItemGroup>

</Project>
